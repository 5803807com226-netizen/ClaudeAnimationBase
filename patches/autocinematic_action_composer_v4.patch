+            return
+        mode = self.dmodevar.get()
+        if mode == "opus" and not messagebox.askyesno(TITLE, "จะเรียก Opus ผ่าน Claude Code บนแพลนของคุณ (ใช้โควตาการใช้งาน ไม่มีค่า API) ทำต่อไหม?", parent=self.win):
+            return
+        self._plan_settings()
+        ch = self.plan["characters"][0]
+        out = self.plans_dir() / f"{self.plan['id']}.directed.json"
+        args = ["tools/action/direct.mjs", f"--text={text}", f"--rig={self.absf(ch['rig'])}", f"--duration={self.plan['duration']}",
+                f"--aspect={self.plan['aspect']}", f"--id={self.plan['id']}", f"--mode={mode}", f"--out={out}",
+                f"--char-id={ch['id']}", f"--x={ch.get('x', .2)}", f"--height={ch.get('height', .34)}"]
+        for p in self.plan.get("props", []):
+            args.append(f"--prop={p['id']}:{self.absf(p['spec'])}")
+        if self.settings.get("claude_command"):
+            args.append(f"--claude={self.settings['claude_command']}")
+
+        def job():
+            code, txt = self.engine().run(args, "Action Director")
+            res = _read(out)
+            if not isinstance(res, dict):
+                raise RuntimeError("ผู้กำกับไม่ได้ส่งแผนกลับมา:\n" + txt[-600:])
+            return code, txt, res
+
+        def done(r):
+            code, txt, res = r
+            self.dirtext.delete("1.0", "end")
+            self.dirtext.insert("end", txt)
+            if code:
+                self.dirtext.insert("end", "\n\n✗ แผนจากผู้กำกับยังไม่ผ่านการตรวจ: ไม่ได้นำมาใช้ (ดูข้อผิดพลาดด้านบน)")
+                return
+            self.plan["actions"] = res.get("actions", [])
+            if res.get("notes"):
+                self.plan["notes"] = res["notes"]
+            self.save_plan(quiet=True)
+            self.select(None)
+            self.dirtext.insert("end", f"\n\n✓ นำ {len(self.plan['actions'])} ท่ามาใส่ไทม์ไลน์แล้ว (แท็บ 3) · บันทึกแผนแล้ว")
+        self.background("ผู้กำกับท่าทาง", job, done)
+
+    # ---------------------------------------------------------------- preview / QA / render
+    def story_id(self):
+        return f"_act_{self.plan['id']}"
+
+    def preview(self):
+        if not self._check_ready():
+            return
+        path = self.save_plan(quiet=True)
+        dur, step = float(self.plan["duration"]), float(self.prevstep.get())
+        times = [round(i * step, 4) for i in range(int(dur / step + 1e-6) + 1) if i * step <= dur]
+        out = self.home / "previews" / f"{self.plan['id']}.jpg"
+        out.parent.mkdir(parents=True, exist_ok=True)
+        w = 160 if self.plan.get("aspect") == "9:16" else 240
+        extra = ["--query=overlay=1"] if self.overlayvar.get() else []
+        extra += self.settings.get("render_flags") or []
+
+        def job():
+            ok, txt = self._build_scene(path)
+            if not ok:
+                return False, txt, None
+            code, t2 = self.engine().run(["render.mjs", f"--story={self.story_id()}", f"--sheet={','.join(f'{t:g}' for t in times)}",
+                                          f"--cols={len(times)}", f"--w={w}", f"--out={out}", *extra], "Preview")
+            if code or not out.is_file():
+                raise RuntimeError("พรีวิวไม่สำเร็จ (ดู log)")
+            return True, txt, out
+
+        def done(r):
+            ok, txt, img = r
+            self._show_validation(txt)
+            self._show_validation(txt, self.qatext)
+            if not ok:
+                self.nb.select(2)
+                return
+            self._load_frames(img, times)
+            self.nb.select(4)
+        self.background("พรีวิว", job, done)
+
+    def _load_frames(self, img_path, times):
+        if Image is None:
+            return
+        im = Image.open(img_path).convert("RGB")
+        n = len(times)
+        tw = im.width // n
+        self.raw_frames = [im.crop((i * tw, 0, (i + 1) * tw, im.height)) for i in range(n)]
+        self.frame_times, self.frames, self._fkey = times, list(self.raw_frames), None
+        self._show_frame()
+
+    def _show_frame(self):
+        c = self.pcanvas
+        c.delete("all")
+        w, h = max(10, c.winfo_width()), max(10, c.winfo_height())
+        if not self.frames:
+            c.create_text(w / 2, h / 2, text="กด ▶ พรีวิว เพื่อดูการเคลื่อนไหว", fill="#bbb", font=("Segoe UI", 11))
+            return
+        i = min(range(len(self.frame_times)), key=lambda k: abs(self.frame_times[k] - self.playhead))
+        im = self.raw_frames[i]
+        s = min(w / im.width, h / im.height)
+        key = (i, w, h)
+        if getattr(self, "_fkey", None) != key:
+            self._ftk, self._fkey = ImageTk.PhotoImage(im.resize((max(1, int(im.width * s)), max(1, int(im.height * s))), Image.BILINEAR)), key
+        c.create_image(w / 2, h / 2, image=self._ftk)
+
+    def toggle_play(self):
+        self.playing = not self.playing
+        self.play_btn.configure(text="⏸ หยุด" if self.playing else "▶ เล่น")
+        if self.playing:
+            if self.playhead >= float(self.plan["duration"]) - 1e-3:
+                self.set_playhead(0)
+            self._t0 = time.time() - self.playhead
+            self._tick()
+
+    def _tick(self):
+        if not self.playing or not self.win.winfo_exists():
+            return
+        t = time.time() - self._t0
+        if t > float(self.plan["duration"]):
+            self.playing = False
+            self.play_btn.configure(text="▶ เล่น")
+            t = float(self.plan["duration"])
+        self.set_playhead(t)
+        if self.playing:
+            self.win.after(40, self._tick)
+
+    def verify(self):
+        if not self._check_ready():
+            return
+        path = self.save_plan(quiet=True)
+        story = self.story_id()
+
+        def job():
+            ok, txt = self._build_scene(path)
+            if not ok:
+                return None, txt
+            code, t2 = self.engine().run(["tools/action/verify.mjs", f"--story={story}", *(self.settings.get("render_flags") or [])], "Motion QA")
+            return _read(Path(self.enginevar.get()) / "out" / "action" / self.plan["id"] / "verify.json"), txt
+
+        def done(r):
+            res, txt = r
+            self.qatext.delete("1.0", "end")
+            if res is None:
+                self._show_validation(txt, self.qatext)
+                return
+            checks = res.get("checks", [])
+            ok = sum(1 for c in checks if c.get("ok"))
+            self.qatext.insert("end", f"{'✓' if ok == len(checks) else '✗'} ผ่าน {ok}/{len(checks)} ข้อ\n\n")
+            for c in checks:
+                self.qatext.insert("end", f"{'✓' if c.get('ok') else '✗'} {c.get('name')}\n    {c.get('detail', '')}\n")
+        self.background("ตรวจคุณภาพการเคลื่อนไหว", job, done)
+
+    def render_mp4(self):
+        if not self._check_ready():
+            return
+        path = self.save_plan(quiet=True)
+        outdir = self.project / "exports" / "action"
+        outdir.mkdir(parents=True, exist_ok=True)
+        out = outdir / f"{self.plan['id']}_{time.strftime('%Y%m%d_%H%M%S')}.mp4"
+        fps = int(self.plan.get("fps", 24))
+        story = self.story_id()
+
+        def job():
+            ok, txt = self._build_scene(path)
+            if not ok:
+                return None, txt
+            code, t2 = self.engine().run(["render.mjs", f"--story={story}", "--clip", f"--fps={fps}", f"--out={out}",
+                                          *(self.settings.get("render_flags") or [])], "Render MP4")
+            if code or not out.is_file():
+                raise RuntimeError("เรนเดอร์ไม่สำเร็จ (ดู log)")
+            info = ""
+            if shutil.which("ffprobe"):
+                p = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "stream=width,height,r_frame_rate,nb_frames",
+                                    "-show_entries", "format=duration", "-of", "json", str(out)], capture_output=True, text=True, creationflags=NO_WINDOW)
+                try:
+                    d = json.loads(p.stdout)
+                    s = d["streams"][0]
+                    info = f"{s['width']}×{s['height']} · {s['r_frame_rate'].split('/')[0]} fps · {s.get('nb_frames', '?')} เฟรม · {float(d['format']['duration']):.2f} วิ"
+                except (ValueError, KeyError, IndexError):
+                    info = "(ffprobe อ่านไม่ได้)"
+            return out, info
+
+        def done(r):
+            res, info = r
+            if res is None:
+                self._show_validation(info, self.qatext)
+                return
+            self.last_mp4 = res
+            self.open_btn.configure(state="normal")
+            self.qatext.insert("end", f"\n🎬 {res.name}\n{info}\n")
+            self.status.set(f"✓ Render MP4: {res} · {info}")
+            self.log(f"[Action] MP4: {res} ({info})")
+        self.background("Render MP4", job, done)
+
+
+def open_action_composer(app, animation_root: str | None = None):
+    return ActionComposer(app, animation_root)
