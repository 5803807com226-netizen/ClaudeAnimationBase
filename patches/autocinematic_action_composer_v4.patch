+    # ---------------------------------------------------------------- catalogue
+    def load_catalog(self):
+        eng = self.engine()
+        problems = eng.check()
+        if problems:
+            self.status.set("⚠ " + problems[0])
+            self.log("[Action] " + " | ".join(problems))
+            return
+        try:
+            d = eng.catalog()
+        except Exception as ex:
+            self.status.set(f"⚠ {ex}")
+            return
+        self.cat, self.layers, self.groups, self.effects = d["catalog"], d["layers"], d["groups"], d["effects"]
+        self._fill_presets()
+        self.status.set(f"พร้อม · คลังท่าทาง {len(self.cat)} ท่า · {len(self.layers)} เลเยอร์")
+        if self.plan:
+            self.timeline.redraw()
+
+    def _fill_presets(self):
+        t = self.preset_tree
+        t.delete(*t.get_children())
+        q = self.searchvar.get().strip().lower()
+        for L in self.layers:
+            names = [n for n, c in self.cat.items() if c["layer"] == L and (not q or q in n or q in c.get("th", "") or q in c.get("about", "").lower())]
+            if not names:
+                continue
+            node = t.insert("", "end", iid=f"L:{L}", text=LAYER_TH.get(L, L), open=True)
+            for n in names:
+                t.insert(node, "end", iid=f"P:{n}", text=f"{self.cat[n].get('th', n)}  ·  {n}")
+
+    def _preset_about(self):
+        s = self.preset_tree.selection()
+        if s and s[0].startswith("P:"):
+            c = self.cat[s[0][2:]]
+            self.aboutvar.set(f"{c.get('about', '')}\nเลเยอร์: {LAYER_TH.get(c['layer'], c['layer'])}\nควบคุม: " + ", ".join(GROUP_TH.get(g, g) for g in c["mask"]))
