+"""Action Composer (ท่าทางตัวละคร): reference image -> rig -> layered actions -> preview -> MP4, inside AutoCinematic ONE.
+
+Opened from the main window (next to "Hybrid Plan / Export"). No new server or backend: the ClaudeAnimationBase engine
+is driven through its command-line tools, like the Motion Plan dialog does:
+  tools/action/rig_analyze.py   character image -> editable rig (char_rig/1), joints marked detected/estimated/uncertain
+  tools/action/prop_analyze.py  prop image -> anchors (grip, grip2, muzzle, origin)
+  tools/action/plan.mjs         --catalog (presets) · --check (validate a Motion Plan) · build the engine scene
+  tools/action/direct.mjs       story text -> Motion Plan (Opus through Claude Code on your plan, or rules without AI)
+  tools/action/verify.mjs       motion QA (feet on the ground, grips, no joint pops)
+  render.mjs                    low-res preview sheet · MP4
+Everything the user makes lives in <project>/action/ (uploads are copied in; an existing file is never overwritten):
+  refs/      the character / prop images, their .rig.json / .prop.json
+  plans/     Motion Plans (motion_plan/1 JSON): the source of truth, editable and re-renderable without AI
+  previews/  low-res preview sheets
+MP4s go to <project>/exports/action/<plan>_<time>.mp4 (a new file each time).
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from tkinter import ttk, filedialog, messagebox
+import tkinter as tk
+
+try:
+    from PIL import Image, ImageDraw, ImageTk
+except ImportError:          # Pillow is in requirements.txt; without it the editors show no picture
+    Image = ImageDraw = ImageTk = None
+
+TITLE = "Action Composer"
+ASPECTS = ("9:16", "16:9", "4:5")
+FRAME = {"9:16": (1080, 1920), "16:9": (1920, 1080), "4:5": (1080, 1350)}
+ID_RE = re.compile(r"^[a-z0-9_]{1,40}$")
+LAYER_TH = {"root": "ตำแหน่งตัว (root)", "lower_body": "ช่วงล่าง / ขา", "upper_body": "ช่วงบน / ลำตัว-แขน", "hands": "มือ / หยิบจับ",
+            "head": "ศีรษะ / สายตา", "secondary": "การเคลื่อนไหวรอง", "effects": "เอฟเฟกต์", "camera": "กล้อง"}
+LAYER_COL = {"root": "#8d6e63", "lower_body": "#2e7d32", "upper_body": "#1565c0", "hands": "#6a1b9a", "head": "#00838f",
+             "secondary": "#9e9d24", "effects": "#e65100", "camera": "#455a64"}
+GROUP_TH = {"root": "ตำแหน่งตัว", "spine": "ลำตัว", "head": "ศีรษะ", "arm_f": "แขนหน้า", "arm_b": "แขนหลัง", "hand_f": "มือหน้า",
+            "hand_b": "มือหลัง", "leg_f": "ขาหน้า", "leg_b": "ขาหลัง", "prop": "พร็อพ", "fx": "เอฟเฟกต์"}
+EFFECT_TH = {"muzzle_flash": "แสงปากกระบอก", "bolt": "ลำแสง", "recoil": "แรงถีบ", "dust": "ฝุ่น", "impact": "แรงกระแทก",
+             "smoke": "ควัน", "trail": "เส้นความเร็ว"}
+CONF_COL = {"detected": "#1eaa3c", "estimated": "#f08c14", "uncertain": "#dc1e1e", "manual": "#286ee6"}
+CONF_TH = {"detected": "ตรวจพบ", "estimated": "ประมาณ", "uncertain": "ไม่แน่ใจ (ควรวางเอง)", "manual": "วางเอง"}
+DEFAULT_DUR = {"pick_up": .8, "drop": .6, "fire": .3, "land": .4, "jump": 1.2, "run": 1.2, "sprint": 1.1, "walk": 1.4, "idle": 1.0,
+               "aim": 1.0, "turn": .4, "dodge": .5, "react": .6, "recoil": .3, "fall": .6, "dust": .4, "impact": .3}
+COMMON = ("strength", "weight", "blend_in", "blend_out", "ease")
+NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0)
+THEME = {"hint": "#666", "warn": "#b71c1c", "bg": None}   # set from the app's ttk theme (AutoCinematic is dark)
+
+
+def _read(p: Path, default=None):
+    try:
+        return json.loads(Path(p).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return default
+
+
+def _write(p: Path, data) -> None:
+    p.parent.mkdir(parents=True, exist_ok=True)
+    tmp = p.with_suffix(p.suffix + ".tmp")
+    tmp.write_text(json.dumps(data, indent=1, ensure_ascii=False), encoding="utf-8")
+    os.replace(tmp, p)
+
+
+def _slug(s: str, n: int = 30) -> str:
+    return (re.sub(r"[^a-z0-9_]+", "_", s.lower()).strip("_") or "item")[:n]
+
+
+def _copy_in(src: Path, folder: Path) -> Path:
+    """Copy an upload into the project; the same file already there is reused, a different one is never overwritten."""
+    folder.mkdir(parents=True, exist_ok=True)
+    name = src.name.lower()
+    ext = next((e for e in (".rig.json", ".prop.json") if name.endswith(e)), src.suffix.lower())
+    stem = _slug(src.name[: -len(ext)])
+    dst, n = folder / f"{stem}{ext}", 2
+    while dst.exists():
+        if dst.read_bytes() == src.read_bytes():
+            return dst
+        dst, n = folder / f"{stem}_{n}{ext}", n + 1
+    shutil.copy2(src, dst)
+    return dst
+
+
+def _open(path, parent) -> None:
+    try:
+        if sys.platform == "win32":
+            os.startfile(str(path))
+        else:
+            subprocess.Popen(["open" if sys.platform == "darwin" else "xdg-open", str(path)])
+    except OSError as ex:
+        messagebox.showerror(TITLE, f"เปิดไม่ได้: {path}\n{ex}", parent=parent)
+
+
+# ----------------------------------------------------------------------------------------------- engine (CLI only)
+class ActionEngine:
+    NEED = ["render.mjs", "tools/action/plan.mjs", "tools/action/direct.mjs", "tools/action/verify.mjs",
+            "tools/action/rig_analyze.py", "tools/action/prop_analyze.py", "src/action/composer.js", "src/action/play.js"]
+
+    def __init__(self, root: Path, log, node: str = "node", python: str | None = None):
+        self.root, self.log, self.node, self.python = Path(root).expanduser().resolve(), log, node, python or sys.executable
+
+    def check(self) -> list[str]:
+        out = [f"ClaudeAnimationBase ไม่มี {n} (โฟลเดอร์ผิด หรือ branch เก่า: git pull แล้ว npm install)" for n in self.NEED
+               if not (self.root / n).exists()]
+        if not (self.root / "node_modules").is_dir():
+            out.append("ClaudeAnimationBase ยังไม่ได้ npm install")
+        if not shutil.which(self.node):
+            out.append(f"ไม่พบ {self.node} (Node.js) ใน PATH")
+        return out
+
+    def run(self, args: list[str], tag: str, py: bool = False, quiet: bool = False) -> tuple[int, str]:
+        cmd = [self.python if py else self.node, *[str(a) for a in args]]
+        self.log(f"[{tag}] $ {subprocess.list2cmdline(cmd)}")
+        p = subprocess.Popen(cmd, cwd=str(self.root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+                             encoding="utf-8", errors="replace", bufsize=1, creationflags=NO_WINDOW)
+        lines = []
+        assert p.stdout is not None
+        for line in p.stdout:
+            lines.append(line.rstrip("\n"))
+            if not quiet:
+                self.log(f"[{tag}] {line.rstrip()}")
+        return p.wait(), "\n".join(lines)
+
+    def catalog(self) -> dict:
+        code, out = self.run(["tools/action/plan.mjs", "--catalog"], "Action catalog", quiet=True)
+        if code:
+            raise RuntimeError("โหลดรายการท่าทางไม่ได้:\n" + out[-800:])
+        return json.loads(out)
+
+
+# ----------------------------------------------------------------------------------------------- point editor (rig / anchors)
+class PointEditor(tk.Canvas):
+    """An image with draggable named points and links: the rig editor (joints, bones) and the attachment editor (anchors)."""
+
+    def __init__(self, master, on_change=None, on_select=None, **kw):
+        super().__init__(master, background="#f4f4f2", highlightthickness=0, **kw)
+        self.on_change, self.on_select = on_change, on_select
+        self.img_path, self.pil, self.points, self.conf, self.links, self.radius = None, None, {}, {}, [], {}
+        self.mode, self.density, self.psize, self.names, self.sel = "texture", 6, 1.0, True, None
+        self._tk, self._key, self._fit, self._drag = None, None, (1.0, 0, 0), None
+        self.bind("<Configure>", lambda e: self.redraw())
+        self.bind("<ButtonPress-1>", self._press)
+        self.bind("<B1-Motion>", self._move)
+        self.bind("<ButtonRelease-1>", self._release)
+
+    def set(self, img_path, points, conf=None, links=(), radius=None):
+        if img_path != self.img_path:
+            self.img_path, self._key = img_path, None
+            self.pil = Image.open(img_path).convert("RGBA") if (Image and img_path and Path(img_path).is_file()) else None
+        self.points, self.conf, self.links, self.radius = points, conf or {}, list(links), radius or {}
+        self.redraw()
+
+    def _render(self, w, h):
+        """The picture at this size: the artwork (texture) or Mode B's coloured points."""
+        iw, ih = self.pil.size
+        s = min(w / iw, h / ih) * .94
+        key = (w, h, self.mode, self.density, self.psize)
+        if key != self._key:
+            if self.mode == "points":
+                d = max(2, int(self.density))
+                small = self.pil.resize((max(1, iw // d), max(1, ih // d)), Image.NEAREST)
+                out = Image.new("RGBA", (max(1, int(iw * s)), max(1, int(ih * s))), (0, 0, 0, 0))
+                dr, r = ImageDraw.Draw(out), max(1.0, d * s * .42 * self.psize)
+                px = small.load()
+                for y in range(small.size[1]):
+                    for x in range(small.size[0]):
+                        c = px[x, y]
+                        if c[3] > 40:
+                            cx, cy = (x + .5) * d * s, (y + .5) * d * s
+                            dr.ellipse((cx - r, cy - r, cx + r, cy + r), fill=c[:3] + (255,))
+                img = out
+            else:
+                img = self.pil.resize((max(1, int(iw * s)), max(1, int(ih * s))), Image.LANCZOS)
+            self._tk, self._key = ImageTk.PhotoImage(img), key
+        return s
+
+    def redraw(self):
+        self.delete("all")
+        w, h = max(10, self.winfo_width()), max(10, self.winfo_height())
+        if self.pil is None:
+            self.create_text(w / 2, h / 2, text="ยังไม่มีรูป: อัปโหลดรูปก่อน", fill="#777")
+            return
+        s = self._render(w, h)
+        iw, ih = self.pil.size
+        ox, oy = (w - iw * s) / 2, (h - ih * s) / 2
+        self._fit = (s, ox, oy)
+        self.create_image(ox, oy, anchor="nw", image=self._tk)
+        P = lambda n: (ox + self.points[n][0] * s, oy + self.points[n][1] * s)
+        for a, b in self.links:
+            if a in self.points and b in self.points:
+                (x0, y0), (x1, y1) = P(a), P(b)
+                r = self.radius.get((a, b))
+                if r and self.sel in (a, b):    # the capsule that claims the artwork for this bone
+                    self.create_line(x0, y0, x1, y1, fill="#9ab4ff", width=max(2, 2 * r * s), capstyle="round", stipple="gray25")
+                self.create_line(x0, y0, x1, y1, fill="#2846dc", width=3, capstyle="round")
+        placed = []
+        for n in self.points:
+            x, y = P(n)
+            k = sum(1 for (px, py) in placed if abs(px - x) < 4 and abs(py - y) < 4)   # points on the same spot: stack labels
+            placed.append((x, y))
+            c = CONF_COL.get(self.conf.get(n, "estimated"), "#888")
+            r = 8 if n == self.sel else 6
+            self.create_oval(x - r - 2, y - r - 2, x + r + 2, y + r + 2, fill="white", outline="")
+            self.create_oval(x - r, y - r, x + r, y + r, fill=c, outline="#111" if n == self.sel else "")
+            if self.names or n == self.sel:
+                right = x > w - 90
+                self.create_text(x - 10 if right else x + 10, y - 9 + 13 * k, text=n, anchor="e" if right else "w", fill="#222", font=("Segoe UI", 8))
+
+    def _img_xy(self, ex, ey):
+        s, ox, oy = self._fit
+        return (ex - ox) / s, (ey - oy) / s
+
+    def _press(self, e):
+        if self.pil is None or not self.points:
+            return
+        s, ox, oy = self._fit
+        best = min(self.points, key=lambda n: (ox + self.points[n][0] * s - e.x) ** 2 + (oy + self.points[n][1] * s - e.y) ** 2)
+        d = ((ox + self.points[best][0] * s - e.x) ** 2 + (oy + self.points[best][1] * s - e.y) ** 2) ** .5
+        self.sel, self._drag = (best, best) if d < 14 else (None, None)
+        if self.on_select:
+            self.on_select(self.sel)
+        self.redraw()
+
+    def _move(self, e):
+        if not self._drag:
+            return
+        iw, ih = self.pil.size
+        x, y = self._img_xy(e.x, e.y)
+        self.points[self._drag] = [round(min(max(x, 0), iw - 1), 1), round(min(max(y, 0), ih - 1), 1)]
+        self.conf[self._drag] = "manual"
+        self.redraw()
+
+    def _release(self, e):
+        if self._drag and self.on_change:
+            self.on_change(self._drag, *self.points[self._drag])
+        self._drag = None
+
+
+# ----------------------------------------------------------------------------------------------- timeline
+class Timeline(tk.Canvas):
+    """Layer rows x time: action bars (blend ramps at their ends), drag to move, drag the right edge to resize,
+    click the ruler to move the playhead. Overlapping actions on one layer share the row in lanes."""
+    GUT, RUL = 150, 26
+
+    def __init__(self, master, ui, **kw):
+        super().__init__(master, background="#fbfbfa", highlightthickness=0, **kw)
+        self.ui, self.drag, self.bars = ui, None, {}
+        self.bind("<Configure>", lambda e: self.redraw())
+        self.bind("<ButtonPress-1>", self._press)
+        self.bind("<B1-Motion>", self._move)
+        self.bind("<ButtonRelease-1>", self._release)
+
+    def geom(self):
+        w, h = max(200, self.winfo_width()), max(120, self.winfo_height())
+        layers = self.ui.layers
+        rh = max(26, (h - self.RUL - 4) / len(layers))
+        pps = (w - self.GUT - 14) / max(.5, float(self.ui.plan.get("duration", 5)))
+        return w, h, rh, pps
+
+    def tx(self, t):
+        return self.GUT + t * self.geom()[3]
+
+    def redraw(self):
+        self.delete("all")
+        plan, ui = self.ui.plan, self.ui
+        w, h, rh, pps = self.geom()
+        dur = float(plan.get("duration", 5))
+        self.create_rectangle(0, 0, w, self.RUL, fill="#eceae4", outline="")
+        step = .5 if pps * .5 > 38 else 1
+        t = 0.0
+        while t <= dur + 1e-6:
+            x = self.GUT + t * pps
+            self.create_line(x, self.RUL - 8, x, h, fill="#e2e0da")
+            self.create_text(x + 2, 4, text=f"{t:g}s", anchor="nw", fill="#555", font=("Segoe UI", 8))
+            t += step
+        for i, L in enumerate(ui.layers):
+            y = self.RUL + i * rh
+            self.create_rectangle(0, y, self.GUT, y + rh, fill="#f2f1ed", outline="#e2e0da")
+            self.create_rectangle(4, y + 5, 10, y + rh - 5, fill=LAYER_COL.get(L, "#777"), outline="")
+            self.create_text(15, y + rh / 2, text=LAYER_TH.get(L, L), anchor="w", fill="#333", font=("Segoe UI", 9))
+            self.create_line(self.GUT, y + rh, w, y + rh, fill="#e8e6e0")
+        self.bars = {}
+        for L, items in ui.lanes().items():
+            row = ui.layers.index(L)
+            n = max(1, max((ln for _, ln in items), default=0) + 1)
+            for i, lane in items:
+                a = plan["actions"][i]
+                x0, x1 = self.GUT + a["start"] * pps, self.GUT + (a["start"] + a["duration"]) * pps
+                y0 = self.RUL + row * rh + 3 + lane * (rh - 6) / n
+                y1 = y0 + (rh - 6) / n - 2
+                col, sel = LAYER_COL.get(L, "#777"), i == ui.sel
+                self.create_rectangle(x0, y0, max(x1, x0 + 4), y1, fill=col, outline="#111" if sel else "white", width=2 if sel else 1)
+                p = a.get("params") or {}
+                for k, side in (("blend_in", 0), ("blend_out", 1)):     # blend ramps
+                    b = float(a.get(k, p.get(k, ui.param_default(a["type"], k) or 0)) or 0) * pps
+                    if b > 2:
+                        bx = x0 if side == 0 else x1
+                        self.create_polygon(bx, y1, bx + (b if side == 0 else 0), y0, bx + (0 if side == 0 else b), y1,
+                                            fill="white", stipple="gray50", outline="")
+                label = ui.cat.get(a["type"], {}).get("th", a["type"])
+                if x1 - x0 > 30:
+                    self.create_text(x0 + 4, (y0 + y1) / 2, text=f"{label}", anchor="w", fill="white", font=("Segoe UI", 8, "bold"))
+                if a.get("effects"):
+                    self.create_text(x1 - 3, y0 + 1, text="✦", anchor="ne", fill="#ffe082", font=("Segoe UI", 8))
+                self.bars[i] = (x0, y0, x1, y1)
+        x = self.GUT + ui.playhead * pps
+        self.create_line(x, 0, x, h, fill="#d32f2f", width=2)
+        self.create_polygon(x - 6, 0, x + 6, 0, x, 9, fill="#d32f2f")
+
+    def _hit(self, ex, ey):
+        for i, (x0, y0, x1, y1) in sorted(self.bars.items(), key=lambda kv: -kv[0]):
+            if x0 - 2 <= ex <= x1 + 4 and y0 <= ey <= y1:
+                return i, abs(ex - x1) < 7 and x1 - x0 > 10
+        return None, False
+
+    def _press(self, e):
+        w, h, rh, pps = self.geom()
+        if e.y < self.RUL or e.x < self.GUT:
+            if e.x >= self.GUT:
+                self.ui.set_playhead((e.x - self.GUT) / pps)
+            self.drag = ("play", None, 0, 0, 0)
+            return
+        i, edge = self._hit(e.x, e.y)
+        if i is None:
+            self.ui.set_playhead((e.x - self.GUT) / pps)
+            self.drag = ("play", None, 0, 0, 0)
+            return
+        a = self.ui.plan["actions"][i]
+        self.drag = ("resize" if edge else "move", i, e.x, a["start"], a["duration"])
+        self.ui.select(i)
+
+    def _move(self, e):
+        if not self.drag:
+            return
+        kind, i, x0, s0, d0 = self.drag
+        w, h, rh, pps = self.geom()
+        dur = float(self.ui.plan.get("duration", 5))
+        if kind == "play":
+            self.ui.set_playhead(min(max((e.x - self.GUT) / pps, 0), dur))
+            return
+        a, dt = self.ui.plan["actions"][i], (e.x - x0) / pps
+        snap = lambda v: round(v * 20) / 20     # 0.05 s
+        if kind == "move":
+            a["start"] = snap(min(max(0, s0 + dt), max(0, dur - a["duration"])))
+        else:
+            a["duration"] = snap(min(max(.05, d0 + dt), dur - a["start"]))
+        self.ui.changed(redraw_params=False)
+        self.ui.sync_param_fields()
+
+    def _release(self, e):
+        self.drag = None
+
+
+# ----------------------------------------------------------------------------------------------- the dialog
+class ActionComposer:
+    def __init__(self, app, animation_root: str | None = None):
+        self.app = app
+        self.ac_root = Path(__file__).resolve().parent.parent
+        self.settings_path = self.ac_root / "hybrid_settings.local.json"
+        self.settings = _read(self.settings_path, {}) or {}
+        self.project = Path(app._project_dir())
+        self.home = self.project / "action"
+        self.busy = False
+        self.cat, self.layers, self.groups, self.effects = {}, list(LAYER_TH), list(GROUP_TH), list(EFFECT_TH)
+        self.plan, self.plan_path, self.sel, self.playhead = None, None, None, 0.0
+        self.frames, self.frame_times, self.playing = [], [], False
+        self.last_mp4 = None
+
+        try:     # follow the app's ttk theme: hints and warnings must stay readable on a dark background
+            bg = ttk.Style(app).lookup("TFrame", "background") or "#d9d9d9"
+            r, g, b = (v / 65535 for v in app.winfo_rgb(bg))
+            dark = .2126 * r + .7152 * g + .0722 * b < .5
