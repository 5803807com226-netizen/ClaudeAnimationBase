+    def _bone_radius(self):
+        b = next((b for b in (self.rig or {}).get("bones", []) if b["name"] == self.bonevar.get()), None)
+        if b:
+            try:
+                b["radius"] = round(float(self.radvar.get()), 1)
+            except (tk.TclError, ValueError):
+                return
+            self.rig_ed.radius[(b["from"], b["to"])] = b["radius"]
+            self.rig_ed.redraw()
