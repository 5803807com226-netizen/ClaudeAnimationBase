+        self.pkindvar.set(self.prop.get("kind", "handheld"))
+        self.pfwdvar.set(self.prop.get("forward", "right"))
+        A = self.prop.get("anchors", {})
+        conf = {n: (c or {}).get("confidence", "estimated") for n, c in (self.prop.get("anchor_confidence") or {}).items()}
+        links = [(a, b) for a, b in (("grip", "muzzle"), ("grip", "grip2")) if a in A and b in A]
+        self.prop_ed.set(sp.parent / self.prop.get("image", ""), {n: list(v) for n, v in A.items()}, conf, links)
+        self.propwarn.set("\n".join(self.prop.get("warnings") or []))
