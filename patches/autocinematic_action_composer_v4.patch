+    def open_plan(self, path: Path):
+        P = _read(path)
+        if not isinstance(P, dict) or P.get("schema") != "motion_plan/1":
+            messagebox.showerror(TITLE, f"ไม่ใช่ Motion Plan (motion_plan/1):\n{path}", parent=self.win)
+            return
+        if Path(path).resolve().parent != self.plans_dir().resolve():
+            # a plan from elsewhere (e.g. the engine's examples) is imported as a copy: the original is never edited
+            src_dir = Path(path).resolve().parent
+            for coll, key in (("characters", "rig"), ("props", "spec")):
+                for c in P.get(coll, []):
+                    sp = (src_dir / c[key]).resolve()
+                    spec = _read(sp, {}) or {}
+                    if spec.get("image"):
+                        _copy_in(sp.parent / spec["image"], self.home / "refs")
+                    c[key] = os.path.relpath(_copy_in(sp, self.home / "refs"), self.plans_dir()).replace("\\", "/")
+            if not ID_RE.fullmatch(str(P.get("id", ""))):
+                P["id"] = _slug(Path(path).stem, 40)
+            path = self.plans_dir() / f"{P['id']}.json"
+            n = 2
+            while path.exists():
+                path = self.plans_dir() / f"{P['id']}_{n}.json"
+                n += 1
+            P["id"] = path.stem
+            _write(path, P)
+            self.log(f"[Action] imported a copy of the plan as {path}")
+        self.plan, self.plan_path, self.sel, self.frames = P, Path(path), None, []
+        P.setdefault("render", {"mode": "texture", "points": {"density": 6, "size": 1}})
+        P.setdefault("props", [])
+        self._load_plan_ui()
+        self.remember()
+        self.status.set(f"เปิดแผน {P['id']} · {len(P.get('actions', []))} ท่า")
+
+    def _load_plan_ui(self):
+        P = self.plan
+        self.aspectvar.set(P.get("aspect", "9:16"))
+        self.durvar.set(P.get("duration", 5))
+        self.fpsvar.set(P.get("fps", 24))
+        self.followvar.set(bool(P.get("camera")))
+        r = P.get("render") or {}
+        self.modevar.set(r.get("mode", "texture"))
+        self.densvar.set((r.get("points") or {}).get("density", 6))
+        self.psizevar.set((r.get("points") or {}).get("size", 1))
+        self._refresh_plan_list()
+        self._fill_chars()
+        self._fill_props()
+        self.scale.configure(to=float(P.get("duration", 5)))
+        self.set_playhead(0)
+        self.select(None)
+        self._mode(save=False)
+
+    def _plan_settings(self):
+        if not self.plan:
+            return
+        try:
+            self.plan["duration"] = round(min(max(float(self.durvar.get()), .5), 120), 2)
+        except (tk.TclError, ValueError):
+            pass
+        self.plan["aspect"], self.plan["fps"] = self.aspectvar.get(), int(self.fpsvar.get())
+        chars = self.plan.get("characters") or []
+        if self.followvar.get() and chars:
+            self.plan["camera"] = {**(self.plan.get("camera") or {"frame_x": .38, "amount": .9}), "follow": chars[0]["id"]}
+        else:
+            self.plan.pop("camera", None)
+        self.scale.configure(to=self.plan["duration"])
+        self.timeline.redraw()
+
+    def save_plan(self, quiet=False) -> Path | None:
+        if not self.plan:
+            return None
+        self._plan_settings()
+        _write(self.plan_path, self.plan)
+        self._refresh_plan_list()
+        self.remember()
+        if not quiet:
+            self.status.set(f"บันทึกแล้ว: {self.plan_path}")
+        return self.plan_path
+
+    def rel(self, p: Path) -> str:
+        return os.path.relpath(p, self.plans_dir()).replace("\\", "/")
+
+    def absf(self, rel: str) -> Path:
+        return (self.plans_dir() / rel).resolve()
+
+    # ---------------------------------------------------------------- characters
+    def _fill_chars(self, select=None):
+        t = self.char_tree
+        t.delete(*t.get_children())
+        for c in self.plan.get("characters", []):
+            t.insert("", "end", iid=c["id"], text=c["id"], values=(Path(c["rig"]).name, c.get("x", .2), c.get("height", .34)))
+        ids = [c["id"] for c in self.plan.get("characters", [])]
+        if ids:
+            t.selection_set(select if select in ids else ids[0])
+        else:
+            self.rig = None
+            self.rig_ed.set(None, {})
+            self.rigwarn.set("")
+
+    def cur_char(self):
+        s = self.char_tree.selection()
+        return next((c for c in self.plan.get("characters", []) if s and c["id"] == s[0]), None)
+
+    def add_character(self):
+        p = filedialog.askopenfilename(title="รูปตัวละคร (PNG พื้นใส, ยืนเต็มตัว, เห็นแขนขาแยกกัน)", parent=self.win,
+                                       filetypes=[("PNG", "*.png"), ("รูปภาพ", "*.png *.webp *.jpg *.jpeg")])
+        if not p:
+            return
+        img = _copy_in(Path(p), self.home / "refs")
+        n = len(self.plan["characters"]) + 1
+        cid = f"CHAR_{n:03d}"
+        while any(c["id"] == cid for c in self.plan["characters"]):
+            n += 1
+            cid = f"CHAR_{n:03d}"
+        self._analyze(img, cid, new=True)
+
+    def analyze_rig(self):
+        c = self.cur_char()
+        if not c:
+            messagebox.showinfo(TITLE, "ยังไม่มีตัวละคร: อัปโหลดรูปก่อน", parent=self.win)
+            return
+        if not messagebox.askyesno(TITLE, "วิเคราะห์ใหม่จะแทนที่ตำแหน่งข้อต่อที่แก้ไว้ของตัวละครนี้ ทำต่อไหม?", parent=self.win):
+            return
+        rig = _read(self.absf(c["rig"]), {}) or {}
+        self._analyze(self.absf(c["rig"]).parent / rig.get("image", ""), c["id"], new=False)
+
+    def _analyze(self, img: Path, cid: str, new: bool):
+        out = img.with_suffix(".rig.json")
+        tmpl = self.templatevar.get()
+
+        def job():
+            code, txt = self.engine().run(["tools/action/rig_analyze.py", f"--image={img}", f"--template={tmpl}", f"--id={_slug(img.stem)}", f"--out={out}"], "Rig", py=True)
+            if code or not out.is_file():
+                raise RuntimeError("วิเคราะห์ rig ไม่สำเร็จ (ดู log): " + txt[-400:])
+            return out
+
+        def done(rig_path):
+            if new:
+                self.plan["characters"].append({"id": cid, "rig": self.rel(rig_path), "x": .2 + .25 * len(self.plan["characters"]), "height": .34, "facing": "right"})
+                if self.followvar.get():
+                    self._plan_settings()
+            self.save_plan(quiet=True)
+            self._fill_chars(select=cid)
+        self.background("วิเคราะห์ Rig", job, done)
+
+    def remove_character(self):
+        c = self.cur_char()
+        if c and messagebox.askyesno(TITLE, f"เอา {c['id']} ออกจากแผน? (ไฟล์รูปและ rig ยังอยู่)", parent=self.win):
+            self.plan["characters"].remove(c)
+            self.plan["actions"] = [a for a in self.plan["actions"] if a.get("character", c["id"]) != c["id"] or self.plan["characters"]]
+            self._plan_settings()
+            self._fill_chars()
+            self.timeline.redraw()
+
+    def _show_char(self):
+        c = self.cur_char()
+        if not c:
+            return
+        self.cxvar.set(c.get("x", .2))
+        self.chvar.set(c.get("height", .34))
+        self.cfacevar.set(c.get("facing", "right"))
+        rp = self.absf(c["rig"])
+        self.rig = _read(rp)
+        if not self.rig:
+            self.rigwarn.set(f"อ่าน rig ไม่ได้: {rp}")
+            self.rig_ed.set(None, {})
+            return
+        self.templatevar.set(self.rig.get("template", "human"))
+        J = self.rig["joints"]
+        pts = {n: [j["x"], j["y"]] for n, j in J.items()}
+        conf = {n: j.get("confidence", "estimated") for n, j in J.items()}
+        links = [(b["from"], b["to"]) for b in self.rig["bones"]]
+        radius = {(b["from"], b["to"]): b.get("radius", 0) for b in self.rig["bones"]}
+        self.rig_ed.set(rp.parent / self.rig.get("image", ""), pts, conf, links, radius)
+        self.bone_box.configure(values=[b["name"] for b in self.rig["bones"]])
+        self._rig_warnings()
+
+    def _rig_warnings(self):
+        unc = [n for n, c in self.rig_ed.conf.items() if c == "uncertain"]
+        w = list(self.rig.get("warnings") or [])
+        self.rigwarn.set(("ข้อต่อที่ไม่แน่ใจ: " + ", ".join(unc) + " — ลากไปวางให้ถูกตำแหน่ง\n" if unc else "") + "\n".join(w))
+
+    def _char_fields(self):
+        c = self.cur_char()
+        if not c:
+            return
+        try:
+            c["x"], c["height"] = round(float(self.cxvar.get()), 3), round(float(self.chvar.get()), 3)
+        except (tk.TclError, ValueError):
+            return
+        c["facing"] = self.cfacevar.get()
+        self.char_tree.item(c["id"], values=(Path(c["rig"]).name, c["x"], c["height"]))
+
+    def _joint_sel(self, name):
+        if not name or not self.rig:
+            self.jointinfo.set("คลิกจุดบนรูป")
+            self.rig_ed.redraw()
+            return
+        x, y = self.rig_ed.points[name]
+        self.jointinfo.set(f"{name} · ({x:.0f}, {y:.0f}) · {CONF_TH.get(self.rig_ed.conf.get(name), '')}")
+        bones = [b for b in self.rig["bones"] if name in (b["from"], b["to"])]
+        if bones:
+            self.bonevar.set(bones[0]["name"])
+            self.radvar.set(bones[0].get("radius", 0))
+
+    def _joint_moved(self, name, x, y):
+        self._joint_sel(name)
+        self._rig_warnings()
+
+    def _bone_sel(self):
+        b = next((b for b in (self.rig or {}).get("bones", []) if b["name"] == self.bonevar.get()), None)
+        if b:
+            self.radvar.set(b.get("radius", 0))
+            self.rig_ed.sel = b["to"]
+            self.rig_ed.redraw()
