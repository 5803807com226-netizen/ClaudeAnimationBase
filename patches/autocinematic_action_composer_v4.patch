+                     "backdrop": {"sky": "#E6EFF3", "ground": "#D6C6A8", "obstacles": []},
+                     "render": {"mode": "texture", "points": {"density": 6, "size": 1}}, "characters": [], "props": [], "actions": []}
+        self.plan_path = self.plans_dir() / f"{pid}.json"
+        self.sel, self.frames = None, []
+        self._load_plan_ui()
