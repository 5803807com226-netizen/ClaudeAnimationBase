+    def save_rig(self):
+        c = self.cur_char()
+        if not c or not self.rig:
+            return
+        for n, (x, y) in self.rig_ed.points.items():
+            j = self.rig["joints"][n]
+            j["x"], j["y"], j["confidence"] = x, y, self.rig_ed.conf.get(n, j.get("confidence"))
+        self.rig["uncertain"] = sorted(n for n, j in self.rig["joints"].items() if j.get("confidence") == "uncertain")
+        self.rig["estimated"] = sorted(n for n, j in self.rig["joints"].items() if j.get("confidence") == "estimated")
+        _write(self.absf(c["rig"]), self.rig)
+        self.frames = []
+        self.status.set(f"บันทึก rig แล้ว: {self.absf(c['rig']).name}" + (f" · ยังไม่แน่ใจ {len(self.rig['uncertain'])} จุด" if self.rig["uncertain"] else ""))
+
+    def _mode(self, save=True):
