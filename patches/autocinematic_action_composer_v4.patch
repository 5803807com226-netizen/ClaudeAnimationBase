+    # ---------------------------------------------------------------- helpers
+    def log(self, msg):
+        try:
+            self.app.log(msg)
+        except Exception:
+            print(msg)
+
+    def engine(self) -> ActionEngine:
+        return ActionEngine(Path(self.enginevar.get()), self.log, node=self.settings.get("node") or "node")
+
+    def remember(self):
+        s = _read(self.settings_path, {}) or {}
+        s["animation_root"] = self.enginevar.get()
+        if self.plan_path:
+            s["action_last_plan"] = str(self.plan_path)
+        try:
+            _write(self.settings_path, s)
+        except OSError as ex:
+            self.log(f"[Action] cannot save settings: {ex}")
+
+    def background(self, label: str, fn, done=None):
+        """Run fn() off the UI thread (one job at a time); done(result) runs on the UI thread, errors are shown in Thai."""
+        if self.busy:
+            messagebox.showinfo(TITLE, "กำลังทำงานอื่นอยู่ รอให้เสร็จก่อน", parent=self.win)
+            return
+        self.busy = True
+        self.status.set(f"⏳ {label}…")
+        self._set_buttons("disabled")
+
+        def work():
+            res, err = None, None
+            try:
+                res = fn()
+            except Exception as ex:          # shown to the user, never swallowed
+                err = ex
+                self.log(f"[Action] {label}: ERROR {ex}")
+
+            def finish():
+                self.busy = False
+                if not self.win.winfo_exists():
+                    return
+                self._set_buttons("normal")
+                if err:
+                    self.status.set(f"✗ {label}: {err}")
+                    messagebox.showerror(TITLE, f"{label} ไม่สำเร็จ:\n{err}", parent=self.win)
+                else:
+                    self.status.set(f"✓ {label}")
+                    if done:
+                        done(res)
+            self.app.after(0, finish)
+        threading.Thread(target=work, daemon=True).start()
+
+    def _set_buttons(self, state):
+        for b in self.job_buttons:
+            try:
+                b.configure(state=state)
+            except tk.TclError:
+                pass
+
+    def param_default(self, typ, k):
+        d = self.cat.get(typ, {}).get("params", {}).get(k)
+        return d.get("default") if d else None
+
+    def layer_of(self, a):
+        return a.get("layer") or self.cat.get(a["type"], {}).get("layer", "upper_body")
+
+    def lanes(self):
+        """{layer: [(action index, lane)]}: overlapping actions of one layer get separate lanes."""
+        out = {}
+        for L in self.layers:
+            idx = sorted([i for i, a in enumerate(self.plan["actions"]) if self.layer_of(a) == L],
+                         key=lambda i: self.plan["actions"][i]["start"])
+            ends, items = [], []
+            for i in idx:
+                a = self.plan["actions"][i]
+                lane = next((k for k, e in enumerate(ends) if e <= a["start"] + 1e-6), len(ends))
+                if lane == len(ends):
+                    ends.append(0)
+                ends[lane] = a["start"] + a["duration"]
+                items.append((i, lane))
+            if items:
+                out[L] = items
+        return out
