+    def analyze_prop(self):
+        p = self.cur_prop()
+        if not p:
+            messagebox.showinfo(TITLE, "ยังไม่มีพร็อพ: อัปโหลดรูปก่อน", parent=self.win)
+            return
+        spec = _read(self.absf(p["spec"]), {}) or {}
+        self._analyze_prop(self.absf(p["spec"]).parent / spec.get("image", ""), p["id"], new=False)
