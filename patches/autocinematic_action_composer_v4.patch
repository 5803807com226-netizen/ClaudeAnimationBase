+    def _analyze_prop(self, img: Path, pid: str, new: bool):
+        out = img.with_suffix(".prop.json")
+        kind, fwd = self.pkindvar.get(), self.pfwdvar.get()
+
+        def job():
+            code, txt = self.engine().run(["tools/action/prop_analyze.py", f"--image={img}", f"--id={_slug(img.stem)}", f"--kind={kind}",
+                                           f"--forward={fwd}", f"--out={out}"], "Prop", py=True)
+            if code or not out.is_file():
+                raise RuntimeError("หาจุดยึดไม่สำเร็จ (ดู log): " + txt[-400:])
+            return out
+
+        def done(spec_path):
+            if new:
+                cx = (self.plan["characters"][0].get("x", .2) + .11) if self.plan["characters"] else .3
+                self.plan["props"].append({"id": pid, "spec": self.rel(spec_path), "x": round(cx, 3), "scale": .72})
+            self.save_plan(quiet=True)
+            self._fill_props(select=pid)
+        self.background("หาจุดยึดพร็อพ", job, done)
