+def action_refs(project: Path, action) -> tuple[Optional[dict], list]:
+    """An action shot's characters and props -> the project's reference images (Character Refs), as absolute paths.
+    Returns (action, missing ids). Opus names ids; the app supplies the pictures (never a path from the model)."""
+    if not isinstance(action, dict):
+        return None, ["(no action block)"]
+    out, missing = json.loads(json.dumps(action)), []
+    for key, view in (("characters", "full_body"), ("props", "any")):
+        for c in out.get(key) or []:
+            c.pop("rig", None), c.pop("spec", None), c.pop("image", None)
+            ref = pick_reference(project, str(c.get("id", "")), c.pop("view", None) or view)
+            if ref is None:
+                missing.append(str(c.get("id")))
+            else:
+                c["image"] = str(Path(ref).resolve())
+    if not out.get("characters"):
+        missing.append("(no character)")
+    return out, missing
+
