diff --git a/remotion/src/index.jsx b/remotion/src/index.jsx
new file mode 100644
index 0000000..4204283
--- /dev/null
+++ b/remotion/src/index.jsx
@@ -0,0 +1,106 @@
+// AutoCinematic Remotion compositions. remotion_pipeline.py writes src/jobData.json
+// (shots with staged media under public/job/, captions, headlines, narration) and
+// renders three compositions from it:
+//   AutoCinematicClean      picture + narration
+//   AutoCinematicCaptioned  + timed captions
+//   AutoCinematicPreview    + captions + semantic headlines
+import React from 'react';
+import {
+  AbsoluteFill, Composition, Html5Audio, Img, OffthreadVideo, Sequence,
+  interpolate, registerRoot, staticFile, useCurrentFrame, useVideoConfig,
+} from 'remotion';
+import job from './jobData.json';
+
+const FONT = '"Leelawadee UI", "Noto Sans Thai", "Sarabun", Tahoma, sans-serif';
+const fps = Math.max(1, Math.round(job.fps || 30));
+const frames = (sec) => Math.max(1, Math.round((sec || 0) * fps));
+
+const Shot = ({ shot }) => {
+  const frame = useCurrentFrame();
+  const { durationInFrames } = useVideoConfig();
+  const fill = { width: '100%', height: '100%', objectFit: 'cover' };
+  if (!shot.media) return <AbsoluteFill style={{ backgroundColor: '#111' }} />;
+  if (shot.media_type === 'video') {
+    // Narration is the soundtrack; clip audio stays muted.
+    return <AbsoluteFill><OffthreadVideo src={staticFile(shot.media)} muted style={fill} /></AbsoluteFill>;
+  }
+  // A still gets a slow push-in so it is not frozen on screen.
+  const scale = interpolate(frame, [0, durationInFrames], [1, 1.06], { extrapolateRight: 'clamp' });
+  return (
+    <AbsoluteFill style={{ overflow: 'hidden' }}>
+      <Img src={staticFile(shot.media)} style={{ ...fill, transform: `scale(${scale})` }} />
+    </AbsoluteFill>
+  );
+};
+
+const activeAt = (items, t) => (items || []).find((c) => t >= c.start_sec && t < c.end_sec);
+
+const Captions = () => {
+  const frame = useCurrentFrame();
+  const { width } = useVideoConfig();
+  const cap = activeAt(job.captions, frame / fps);
+  if (!cap || !cap.text) return null;
+  return (
+    <AbsoluteFill style={{ justifyContent: 'flex-end', alignItems: 'center', paddingBottom: '13%' }}>
+      <div style={{
+        maxWidth: '84%', textAlign: 'center', fontFamily: FONT, fontWeight: 700,
+        fontSize: Math.round(width * 0.052), lineHeight: 1.35, color: '#FFFFFF',
+        padding: `${Math.round(width * 0.012)}px ${Math.round(width * 0.03)}px`,
+        backgroundColor: 'rgba(12,12,16,0.62)', borderRadius: Math.round(width * 0.02),
+        // Thai has few spaces: allow breaks anywhere rather than overflowing.
+        wordBreak: 'break-word', overflowWrap: 'anywhere',
+      }}>{cap.text}</div>
+    </AbsoluteFill>
+  );
+};
+
+const HEADLINE_TOP = { top: '9%', upper_mid: '22%', center: '42%' };
+
+const Headlines = () => {
+  const frame = useCurrentFrame();
+  const { width } = useVideoConfig();
+  const t = frame / fps;
+  const h = job.semantic_headlines === false ? null : activeAt(job.headlines, t);
+  if (!h || !h.text) return null;
+  const pop = interpolate(t - h.start_sec, [0, 0.18], [0.85, 1], { extrapolateLeft: 'clamp', extrapolateRight: 'clamp' });
+  return (
+    <AbsoluteFill style={{ alignItems: 'center' }}>
+      <div style={{
+        position: 'absolute', top: HEADLINE_TOP[job.headline_position] || HEADLINE_TOP.upper_mid,
+        maxWidth: '86%', textAlign: 'center', fontFamily: FONT, fontWeight: 800,
+        fontSize: Math.round(width * 0.11), lineHeight: 1.1, color: '#FFE45C',
+        textShadow: '0 4px 18px rgba(0,0,0,0.65), 0 0 2px #000', transform: `scale(${pop})`,
+        overflowWrap: 'anywhere',
+      }}>{h.text}</div>
+    </AbsoluteFill>
+  );
+};
+
+const Film = ({ captions, headlines }) => (
+  <AbsoluteFill style={{ backgroundColor: '#000' }}>
+    {(job.shots || []).map((s) => (
+      <Sequence key={s.shot_id} from={Math.round((s.start_sec || 0) * fps)} durationInFrames={frames(s.duration_sec)}>
+        <Shot shot={s} />
+      </Sequence>
+    ))}
+    {job.narration ? <Html5Audio src={staticFile(job.narration)} /> : null}
+    {headlines ? <Headlines /> : null}
+    {captions ? <Captions /> : null}
+  </AbsoluteFill>
+);
+
+const Root = () => {
+  const common = {
+    durationInFrames: frames(job.duration_sec), fps,
+    width: job.width || 768, height: job.height || 1344,
+  };
+  return (
+    <>
+      <Composition id="AutoCinematicClean" component={Film} defaultProps={{ captions: false, headlines: false }} {...common} />
+      <Composition id="AutoCinematicCaptioned" component={Film} defaultProps={{ captions: true, headlines: false }} {...common} />
+      <Composition id="AutoCinematicPreview" component={Film} defaultProps={{ captions: true, headlines: true }} {...common} />
+    </>
+  );
+};
+
+registerRoot(Root);
