+def _ass_break_thai(text: str, per_line: float, max_lines: int = 3) -> str:
+    """Break unspaced text into lines of about per_line visible characters, never
+    inside a syllable (no break before a combining mark or following vowel, none
+    right after a leading vowel)."""
+    import unicodedata
+    per_line = max(4, int(per_line))
+    lines, rest = [], text
+    while rest and len(lines) < max_lines - 1:
+        visible, cut = 0, 0
+        while cut < len(rest) and visible < per_line:
+            if unicodedata.category(rest[cut]) != 'Mn':
+                visible += 1
+            cut += 1
+        if cut >= len(rest):
+            break
+        while cut < len(rest) and (unicodedata.category(rest[cut]) == 'Mn' or rest[cut] in 'ะาำๅ'):
+            cut += 1
+        while 0 < cut < len(rest) and rest[cut - 1] in 'เแโใไ':
+            cut -= 1
+        lines.append(rest[:cut])
+        rest = rest[cut:]
+    if rest:
+        # The plate holds max_lines lines: shorten the last one (as the Pillow path does).
+        visible = [i for i, ch in enumerate(rest) if unicodedata.category(ch) != 'Mn']
+        if len(visible) > per_line:
+            cut = visible[per_line - 1]
+            while cut < len(rest) and unicodedata.category(rest[cut]) == 'Mn':
+                cut += 1
+            rest = rest[:cut].rstrip() + '…'
+        lines.append(rest)
+    return '\\N'.join(lines)
+
